# ---- Browser-safe values (Supabase → Project Settings → API) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key. It is designed to be public; Row Level Security protects the data.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional, demo only. When "true" the login page shows one-click demo accounts that use VITE_DEMO_PASSWORD.
# Leave unset (or "false") for anything real: the demo password then never appears in the bundle.
VITE_SHOW_DEMO_ACCOUNTS=false
VITE_DEMO_PASSWORD=

# ---- SECRET: server / CLI only. NEVER prefix with VITE_ and never commit it. ----
# Used only by scripts/seed-storage.mjs (uploads placeholder files for the seed documents).
SUPABASE_SERVICE_ROLE_KEY=
